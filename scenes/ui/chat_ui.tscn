[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/chat_ui.gd" id="1_chat"]
[ext_resource type="Script" path="res://scripts/local_llm.gd" id="2_llm"]

[ext_resource type="Theme" path="res://ui/themes/medieval_theme.tres" id="medieval"]

[node name="ChatUI" type="Control"]
texture_filter = 1
theme = ExtResource("medieval")
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("1_chat")

[node name="LocalLLM" type="Node" parent="."]
unique_name_in_owner = true
script = ExtResource("2_llm")

[node name="ChatPromptBtn" type="Button" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 1
anchors_preset = 7
anchor_left = 0.5
anchor_top = 1.0
anchor_right = 0.5
anchor_bottom = 1.0
offset_left = -120.0
offset_top = -80.0
offset_right = 120.0
offset_bottom = -34.0
grow_horizontal = 2
grow_vertical = 0
text = "[E] Chat with Barnaby"

[node name="ChatWindow" type="PanelContainer" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 1
anchor_top = 0.46
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 12.0
offset_top = 0.0
offset_right = -12.0
offset_bottom = -12.0
grow_horizontal = 2
grow_vertical = 0

[node name="VBox" type="VBoxContainer" parent="ChatWindow"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="BodyScroll" type="ScrollContainer" parent="ChatWindow/VBox"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Body" type="VBoxContainer" parent="ChatWindow/VBox/BodyScroll"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="HeaderHBox" type="HBoxContainer" parent="ChatWindow/VBox/BodyScroll/Body"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="AvatarFrame" type="PanelContainer" parent="ChatWindow/VBox/BodyScroll/Body/HeaderHBox"]
theme_type_variation = &"Inset"
layout_mode = 2
size_flags_vertical = 4

[node name="NPCAvatar" type="ColorRect" parent="ChatWindow/VBox/BodyScroll/Body/HeaderHBox/AvatarFrame"]
unique_name_in_owner = true
custom_minimum_size = Vector2(24, 24)
layout_mode = 2
color = Color(0.2, 0.7, 0.35, 1)

[node name="TargetLabel" type="Label" parent="ChatWindow/VBox/BodyScroll/Body/HeaderHBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "Marla (Empathetic Baker)"
autowrap_mode = 2
theme_override_font_sizes/font_size = 18

[node name="CloseBtn" type="Button" parent="ChatWindow/VBox/BodyScroll/Body/HeaderHBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(30, 26)
layout_mode = 2
text = "Close"
tooltip_text = "End conversation (Escape)"

[node name="NPCStatsLabel" type="Label" parent="ChatWindow/VBox/BodyScroll/Body"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 2
theme_override_font_sizes/font_size = 14
text = "Trust: 65% | Suspicion: 10% | Daily Budget: 220 / 220 Kurtos"

[node name="DialoguePanel" type="PanelContainer" parent="ChatWindow/VBox/BodyScroll/Body"]
custom_minimum_size = Vector2(0, 88)
theme_type_variation = &"Inset"
layout_mode = 2
size_flags_vertical = 3

[node name="DialogueScroll" type="ScrollContainer" parent="ChatWindow/VBox/BodyScroll/Body/DialoguePanel"]
unique_name_in_owner = true
layout_mode = 2
horizontal_scroll_mode = 0

[node name="DialogueText" type="RichTextLabel" parent="ChatWindow/VBox/BodyScroll/Body/DialoguePanel/DialogueScroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
bbcode_enabled = true
text = "[color=#f5d76e][b]Marla:[/b][/color] Hello traveler! What can I do for you today?"
fit_content = true
scroll_following = true

[node name="InputHBox" type="HBoxContainer" parent="ChatWindow/VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="MessageInput" type="LineEdit" parent="ChatWindow/VBox/InputHBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "Type your pitch or message..."
expand_to_text_length = false
clear_button_enabled = true

[node name="PitchBtn" type="Button" parent="ChatWindow/VBox/InputHBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(100, 32)
layout_mode = 2
text = "Suggest pitch"
tooltip_text = "Prepare a suggested pitch; Send submits it."

[node name="SendBtn" type="Button" parent="ChatWindow/VBox/InputHBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(70, 32)
layout_mode = 2
text = "Send"
